# LLM Provider API Keys (Choose one or more)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Integration & PR Reviews
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=your_username_or_org
GITHUB_REPO_NAME=target_repo_name

# TrueForge Harness Configuration
TRUEFORGE_SANDBOX_DIR=./demo-repo
TRUEFORGE_LOG_LEVEL=info
TRUEFORGE_ENABLE_HUMAN_APPROVAL=true
